#!/bin/sh

# Keep the generated project document center aligned with its source documents.
node_executable="$(command -v node 2>/dev/null || true)"
if [ -z "$node_executable" ]; then
  for candidate in \
    "/c/Program Files/nodejs/node.exe" \
    "$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe"
  do
    if [ -x "$candidate" ]; then
      node_executable="$candidate"
      break
    fi
  done
fi

if [ -z "$node_executable" ]; then
  echo "error: Node.js is required to refresh the project document center" >&2
  exit 1
fi

if ! "$node_executable" scripts/sync-project-docs.mjs; then
  echo "error: project document center refresh failed" >&2
  exit 1
fi

git add -- PROJECT_HANDBOOK.md docs/PROJECT_DOCUMENT_INDEX.md docs/PROJECT_DOCUMENT_CENTER.html
