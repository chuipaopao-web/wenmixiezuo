#!/bin/sh

# Refresh the current document center after switching branches or revisions.
node_executable="$(command -v node 2>/dev/null || true)"
if [ -z "$node_executable" ]; then
  for candidate in \
    "/c/Program Files/nodejs/node.exe" \
    "$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe"
  do
    if [ -x "$candidate" ]; then
      node_executable="$candidate"
      break
    fi
  done
fi

if [ -n "$node_executable" ]; then
  "$node_executable" scripts/sync-project-docs.mjs || echo "warning: project document center refresh failed" >&2
fi