{
  "name": "wenmi-writing",
  "version": "1.0.0",
  "private": true,
  "productName": "文秘写作",
  "description": "文秘写作：统一账号的多Agent协同小说创作平台",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "acceptance": "vitest run tests/acceptance && node scripts/acceptance-audit.mjs",
    "build": "npm run build -w @wenmi/contracts && npm run build -w @wenmi/api && npm run build -w @wenmi/worker && npm run build -w @wenmi/web",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run build -w @wenmi/contracts && concurrently --kill-others-on-fail --names API,WORKER,WEB --prefix-colors cyan,magenta,green \"npm run dev -w @wenmi/api\" \"npm run dev -w @wenmi/worker\" \"npm run dev -w @wenmi/web\"",
    "docs:check": "node scripts/sync-project-docs.mjs --check",
    "docs:open": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/open-project-docs.ps1",
    "docs:sync": "node scripts/sync-project-docs.mjs",
    "development:settle": "node scripts/sync-project-docs.mjs && npm run verify && node scripts/sync-project-docs.mjs --check",
    "evaluate:scale": "tsx scripts/evaluation/final-scale-replay.ts",
    "ledger:init": "node scripts/release-ledger.mjs init",
    "ledger:status": "node scripts/release-ledger.mjs status",
    "migrate": "npm run migrate -w @wenmi/api",
    "models:install": "node scripts/models/install-local-semantic-model.mjs install",
    "models:probe": "tsx scripts/models/probe-local-embedding-model.ts",
    "models:verify": "node scripts/models/install-local-semantic-model.mjs verify",
    "runtime:model-connectivity": "tsx scripts/evaluation/subscription-model-connectivity.ts",
    "runtime:vector-e2e": "tsx scripts/evaluation/local-vector-e2e.ts",
    "evaluate:retrieval-gold": "tsx scripts/evaluation/retrieval-gold-evaluation.ts",
    "verify:backup": "tsx scripts/evaluation/production-backup-verify.ts",
    "start": "node scripts/start.mjs",
    "test": "npm run build -w @wenmi/contracts && vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run build -w @wenmi/contracts && npm run typecheck -w @wenmi/api && npm run typecheck -w @wenmi/worker && npm run typecheck -w @wenmi/web && tsc -p tsconfig.tests.json --noEmit",
    "verify": "npm run docs:sync && npm run typecheck && npm run test && npm run build && npm run docs:check"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "concurrently": "10.0.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
