# 文秘写作 · 生产环境变量模板
# ==========================================
# 部署时复制为 /opt/wenmi/deploy/.env.production 并填入真实值。
# 切勿将 .env.production 提交到 Git 仓库。
#
# 所有以 WENMI_ARK_ 开头的密钥都从环境变量读取，
# 不会写入 SQLite、日志、备份或导出文件。

# ---- 必填：公网部署 ----
# 公网域名（完整 URL，用于安全校验和 Cookie 域）
WENMI_PUBLIC_ORIGIN=https://wenmixiezuo.com

# ---- 必填：服务绑定 ----
# API 监听地址（公网部署必须为 127.0.0.1，由 Caddy 反向代理对外）
WENMI_API_HOST=127.0.0.1
# API 监听端口（默认 43111）
WENMI_API_PORT=43111
# Web Origin（Caddy 代理后的外部地址）
WENMI_WEB_ORIGIN=https://wenmixiezuo.com

# ---- 必填：数据目录 ----
# 项目根目录
WENMI_PROJECT_ROOT=/opt/wenmi
# 数据目录（数据库、文件、备份、日志等）
WENMI_DATA_DIR=/opt/wenmi/data

# ---- 必填：模型凭证 ----
# 火山方舟 Agent Plan 套餐（创作模型）
WENMI_ARK_AGENT_PLAN_API_KEY=your-agent-plan-api-key
WENMI_ARK_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
# 各岗位模型绑定（模型 ID 从火山方舟控制台获取）
WENMI_ARK_AGENT_PLAN_GLM_MODEL=your-glm-model-id
WENMI_ARK_AGENT_PLAN_DOUBAO_MODEL=your-doubao-model-id
WENMI_ARK_AGENT_PLAN_KIMI_MODEL=your-kimi-model-id
WENMI_ARK_AGENT_PLAN_KIMI_K27_MODEL=your-kimi-k27-model-id
WENMI_ARK_AGENT_PLAN_DEEPSEEK_MODEL=your-deepseek-model-id
WENMI_ARK_AGENT_PLAN_DEEPSEEK_FLASH_MODEL=your-deepseek-flash-model-id
WENMI_ARK_AGENT_PLAN_MINIMAX_MODEL=your-minimax-model-id

# 火山方舟 Coding Plan 套餐（Codex 代码辅助，可选）
# WENMI_ARK_CODING_PLAN_API_KEY=your-coding-plan-api-key
# WENMI_ARK_CODING_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# WENMI_ARK_CODING_PLAN_DEEPSEEK_MODEL=your-coding-deepseek-model-id

# ---- 可选：opencodego（与火山方舟二选一，配置后优先） ----
# 把创作模型的 provider/baseUrl/apiKey 整体切到 opencodego（Anthropic 兼容 Messages 端点）。
# 角色模型分配默认沿用 Agent Plan 同款（DeepSeek V4 Pro / GLM 5.2 / Kimi K2.7 / 豆包 / MiniMax / Flash），
# 可用下面的 WENMI_OPENCODEGO_*_MODEL 逐角色覆盖；opencodego 不提供某模型时，该角色可换名或改走方舟。
# 2026-08-16 实测 go 目录没有豆包模型：体验席默认继续使用上方火山方舟 Agent Plan 的豆包配置，
# 因此切换 opencodego 后仍须保留 WENMI_ARK_AGENT_PLAN_API_KEY；只有显式设置下方 DOUBAO 变量才切换。
# 密钥只进环境变量，绝不写入 Git / SQLite / 日志 / 备份 / 导出文件。
# WENMI_OPENCODEGO_API_KEY=your-opencodego-api-key
# WENMI_OPENCODEGO_BASE_URL=https://opencode.ai/zen/go
# WENMI_OPENCODEGO_DEEPSEEK_MODEL=deepseek-v4-pro
# WENMI_OPENCODEGO_DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# WENMI_OPENCODEGO_GLM_MODEL=glm-5.2
# WENMI_OPENCODEGO_KIMI_K27_MODEL=kimi-k2.7-code
# WENMI_OPENCODEGO_DOUBAO_MODEL=doubao-seed-2.1-turbo  # 默认不设置=体验席留在方舟
# WENMI_OPENCODEGO_MINIMAX_MODEL=minimax-m3

# ---- 可选：安全配置 ----
# Worker 令牌（留空则自动生成随机令牌，但重启会变）
# 建议生产环境设置固定值（至少 32 字符）
# WENMI_WORKER_TOKEN=your-fixed-worker-token-at-least-32-chars

# 提示词查看密码（管理员可用；留空则不启用）
# WENMI_PROMPT_VIEW_PASSWORD=your-secure-password

# ---- 可选：日志级别 ----
# 可选值：trace, debug, info, warn, error, fatal
# 生产环境建议 info 或 warn
WENMI_LOG_LEVEL=info