# 文秘写作 · 生产环境变量模板
# ==========================================
# 部署时复制为 /opt/wenmi/deploy/.env.production 并填入真实值。
# 切勿将 .env.production 提交到 Git 仓库。
#
# 所有以 WENMI_ARK_ 开头的密钥都从环境变量读取，
# 不会写入 SQLite、日志、备份或导出文件。

# ---- 必填：公网部署 ----
# 公网域名（完整 URL，用于安全校验和 Cookie 域）
WENMI_PUBLIC_ORIGIN=https://wenmixiezuo.com
# 独立管理后台Origin（用于Host、CORS与写入来源校验）
WENMI_ADMIN_ORIGIN=https://admin.wenmixiezuo.com

# ---- 必填：服务绑定 ----
# API 监听地址（公网部署必须为 127.0.0.1，由 Caddy 反向代理对外）
WENMI_API_HOST=127.0.0.1
# API 监听端口（默认 43111）
WENMI_API_PORT=43111
# Web Origin（Caddy 代理后的外部地址）
WENMI_WEB_ORIGIN=https://wenmixiezuo.com

# ---- 必填：数据目录 ----
# 项目根目录
WENMI_PROJECT_ROOT=/opt/wenmi
# 数据目录（数据库、文件、备份、日志等）
WENMI_DATA_DIR=/opt/wenmi/data

# ---- 必填：模型凭证 ----
# 全部模型统一Agent Plan；无需Coding密钥，缺凭据不可调用，不回退按量通道。
# 模型ID默认使用代码批准的名册；如需覆盖，使用WENMI_ARK_AGENT_PLAN_*_MODEL。
WENMI_ARK_AGENT_PLAN_API_KEY=your-agent-plan-api-key
WENMI_ARK_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan

# ---- 可选：封面图片覆盖配置 ----
# 默认直接使用 Agent Plan 套餐中的 Seedream 5.0 lite 权益，无需再填图片密钥。
# 专用按量图片密钥不再使用，图片同样走Agent Plan。
# WENMI_ARK_IMAGE_MODEL_ID=doubao-seedream-5-0-260128
# ---- 可选：安全配置 ----
# Worker 令牌（留空则自动生成随机令牌，但重启会变）
# 建议生产环境设置固定值（至少 32 字符）
# WENMI_WORKER_TOKEN=your-fixed-worker-token-at-least-32-chars

# 提示词查看密码（管理员可用；留空则不启用）
# WENMI_PROMPT_VIEW_PASSWORD=your-secure-password

# ---- 可选：日志级别 ----
# 可选值：trace, debug, info, warn, error, fatal
# 生产环境建议 info 或 warn
WENMI_LOG_LEVEL=info
